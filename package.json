{
  "name": "raven",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:audit": "vite --mode audit --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "audit:visual": "playwright test -c audit/playwright.config.ts",
    "audit:selftest": "playwright test -c audit/playwright.config.ts selftest",
    "audit:baseline": "AUDIT_PIXEL=1 playwright test -c audit/playwright.config.ts pixel --update-snapshots",
    "audit:pixel": "AUDIT_PIXEL=1 playwright test -c audit/playwright.config.ts pixel"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "highlight.js": "^11.12.0",
    "prosekit": "^0.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.21.0",
    "react-router": "^7.18.5",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
