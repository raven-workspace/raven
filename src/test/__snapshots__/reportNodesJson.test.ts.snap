{"type":"list","attrs":{"kind":"bullet","source":"finding:f-exam-grafana-repo","gen":"1a1ad82d"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Datasource password in the Grafana provisioning repo","marks":[{"type":"bold"}]},{"type":"text","text":" (High): The web root serves "},{"type":"text","text":"/.git/","marks":[{"type":"code"}]},{"type":"text","text":". Its history holds the database password that a later commit removed:"}]},{"type":"codeBlock","attrs":{"language":""},"content":[{"type":"text","text":"commit 4be1d9c07a52e3f86d10b2c4e7f9a0315d6c8e22 Author: Site Admin <admin@exam.lab> Date:   Fri Nov 18 17:22:48 2022 +0200\\n\\n    Add the reporting datasource\\n\\ndiff --git a/datasources/mysql.yaml b/datasources/mysql.yaml\\n--- a/datasources/mysql.yaml\\n+++ b/datasources/mysql.yaml\\n@@ -4,7 +4,7 @@ class Database{\\n-    private $username = \\"dev@exam.lab\\";\\n-    private $password = \\"CopperKite71\\";\\n+    private $username = \\"\\";\\n+    private $password = \\"\\";\\n     public function getConnection() {\\n         $this->conn = null;\\n         try{\\n             $this->conn = new PDO(\\"mysql:host=\\" . $this->host . \\";dbname=\\" . $this->db_name, $this->username, $this->password);\\n             $this->conn->exec(\\"set names utf8\\");\\n         }catch(PDOException $exception){\\n             echo \\"Connection error: \\" . $exception->getMessage();\\n         }\\n         return $this->conn;\\n     }\\n+} +?>"}]},{"type":"paragraph","content":[{"type":"text","text":"Affected: http-git (port 80)"}]}]}
{"type":"list","attrs":{"kind":"bullet","source":"finding:f-exam-joomla-upload","gen":"925c4368"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Joomla 4.2.4 — Malicious File Upload","marks":[{"type":"bold"}]},{"type":"text","text":" (High): Inadequate checks in the Media Manager allowed users with \\"edit\\" privileges to change file extension to arbitrary extension, including .php and other potentially executable extensions."}]}]}
{"type":"list","attrs":{"kind":"bullet","source":"finding:f-exam-ssh-password","gen":"8ee76acb"},"content":[{"type":"paragraph","content":[{"type":"text","text":"SSH password authentication enabled","marks":[{"type":"bold"}]},{"type":"text","text":" (High): "},{"type":"text","text":"PasswordAuthentication","marks":[{"type":"code"}]},{"type":"text","text":" unset in "},{"type":"text","text":"sshd_config","marks":[{"type":"code"}]},{"type":"text","text":" and drop-ins, so the OpenSSH default ("},{"type":"text","text":"yes","marks":[{"type":"code"}]},{"type":"text","text":") applies; any leaked/guessed password yields a remote shell."}]}]}
{"type":"list","attrs":{"kind":"bullet","source":"finding:f-exam-joomla-readable","gen":"49cb2e7b"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Live Joomla install world-readable by low-priv user","marks":[{"type":"bold"}]},{"type":"text","text":" (Medium): the full "},{"type":"text","text":"/var/www/html/cms/","marks":[{"type":"code"}]},{"type":"text","text":" tree is root-owned but mode "},{"type":"text","text":"755/644","marks":[{"type":"code"}]},{"type":"text","text":", so "},{"type":"text","text":"dev","marks":[{"type":"code"}]},{"type":"text","text":" can read the live "},{"type":"text","text":"configuration.php","marks":[{"type":"code"}]},{"type":"text","text":" with the DB password."}]}]}
{"type":"list","attrs":{"kind":"bullet","source":"finding:f-exam-joomla-installation","gen":"5d6c7ebd"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Joomla \`installation/\` directory left in webroot","marks":[{"type":"bold"}]},{"type":"text","text":" (Low): post-install cleanup skipped (Joomla mandates deleting it). The install SQL under "},{"type":"text","text":"cms/installation/sql/","marks":[{"type":"code"}]},{"type":"text","text":" is world-readable and holds a "},{"type":"text","text":"planted LDAP bind cred","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"text","text":"admin/bobby7","marks":[{"type":"code"}]},{"type":"text","text":" ("},{"type":"text","text":"cred #7","marks":[{"type":"code"}]},{"type":"text","text":") in the "},{"type":"text","text":"plg_authentication_ldap","marks":[{"type":"code"}]},{"type":"text","text":" default params; stock ships these empty."}]}]}
