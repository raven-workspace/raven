{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" dev may run /usr/bin/tar as root without a password. tar's --checkpoint-action runs any command."}],"attrs":{"source":"finding:f-exam-tar:explanation","gen":"ded9ebfe"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Remove the sudo rule, or replace it with a wrapper script that takes no arguments."}],"attrs":{"source":"finding:f-exam-tar:fix","gen":"b5e83a8c"}}
