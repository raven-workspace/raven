ph"}]},{"type":"tableCell","content":[{"type":"paragraph"}]}]},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"1433/tcp"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"ms-sql-s"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Microsoft SQL Server 2019 15.00.2000.00"}]}]},{"type":"tableCell","content":[{"type":"paragraph"}]}]},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"5985/tcp"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"HTTP"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Microsoft HTTPAPI httpd 2.0"}]}]},{"type":"tableCell","content":[{"type":"paragraph"}]}]}]}
