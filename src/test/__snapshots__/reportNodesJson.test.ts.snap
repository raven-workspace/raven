{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The password of "},{"type":"text","text":"svc_backup","marks":[{"type":"code"}]},{"type":"text","text":", found in "},{"type":"text","text":"backup/notes.txt","marks":[{"type":"bold"}]},{"type":"text","text":" on web01's share, is also its password on xfer03. SSH accepts passwords, so it logs in as "},{"type":"text","text":"svc_backup","marks":[{"type":"code"}]},{"type":"text","text":" with a shell."}],"attrs":{"source":"finding:f-exam-xfer-reuse:explanation","gen":"f5230b1d"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]}],"attrs":{"source":"finding:f-exam-xfer-reuse:fix","gen":"bd71324c"}}
{"type":"list","attrs":{"kind":"bullet","source":"finding:f-exam-xfer-reuse:fix","gen":"7363b402"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Give "},{"type":"text","text":"svc_backup","marks":[{"type":"code"}]},{"type":"text","text":" a unique password on each host."}]}]}
