{"type":"heading","attrs":{"level":3,"source":"phase:h-exam-web:additional:f-exam-grafana-repo"},"content":[{"type":"text","text":"Datasource password in the Grafana provisioning repo"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The web root serves "},{"type":"text","text":"/.git/","marks":[{"type":"code"}]},{"type":"text","text":". Its history holds the database password that a later commit removed:"}]}
{"type":"codeBlock","attrs":{"language":""},"content":[{"type":"text","text":"commit 4be1d9c07a52e3f86d10b2c4e7f9a0315d6c8e22 Author: Site Admin <admin@exam.lab> Date:   Fri Nov 18 17:22:48 2022 +0200\\n\\n    Add the reporting datasource\\n\\ndiff --git a/datasources/mysql.yaml b/datasources/mysql.yaml\\n--- a/datasources/mysql.yaml\\n+++ b/datasources/mysql.yaml\\n@@ -4,7 +4,7 @@ class Database{\\n-    private $username = \\"dev@exam.lab\\";\\n-    private $password = \\"CopperKite71\\";\\n+    private $username = \\"\\";\\n+    private $password = \\"\\";\\n     public function getConnection() {\\n         $this->conn = null;\\n         try{\\n             $this->conn = new PDO(\\"mysql:host=\\" . $this->host . \\";dbname=\\" . $this->db_name, $this->username, $this->password);\\n             $this->conn->exec(\\"set names utf8\\");\\n         }catch(PDOException $exception){\\n             echo \\"Connection error: \\" . $exception->getMessage();\\n         }\\n         return $this->conn;\\n     }\\n+} +?>"}]}
{"type":"paragraph","content":[{"type":"text","text":"Affected: http-git (port 80)"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Fix:","marks":[{"type":"bold"}]},{"type":"text","text":" env vars, .gitignore, secrets managers, pre-commit hooks like gitleaks. Once a secret has been pushed to remote, it's burned and must be rotated. Scrub repo history."}]}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"heading","attrs":{"level":3,"source":"phase:h-exam-web:additional:f-exam-joomla-upload"},"content":[{"type":"text","text":"Joomla 4.2.4 — Malicious File Upload"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The upload filter trusts the extension only."}]}
{"type":"paragraph","attrs":{"hint":"How to fix it"}}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High (CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H)"}]}
{"type":"heading","attrs":{"level":3,"source":"phase:h-exam-web:additional:f-exam-ssh-password"},"content":[{"type":"text","text":"SSH password authentication enabled"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"text","text":"PasswordAuthentication","marks":[{"type":"code"}]},{"type":"text","text":" unset in "},{"type":"text","text":"sshd_config","marks":[{"type":"code"}]},{"type":"text","text":" and drop-ins, so the OpenSSH default ("},{"type":"text","text":"yes","marks":[{"type":"code"}]},{"type":"text","text":") applies; any leaked/guessed password yields a remote shell."}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Fix config to only allow ssh w/ id_rsa"}]}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"heading","attrs":{"level":3,"source":"phase:h-exam-web:additional:f-exam-joomla-readable"},"content":[{"type":"text","text":"Live Joomla install world-readable by low-priv user"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" the full "},{"type":"text","text":"/var/www/html/cms/","marks":[{"type":"code"}]},{"type":"text","text":" tree is root-owned but mode "},{"type":"text","text":"755/644","marks":[{"type":"code"}]},{"type":"text","text":", so "},{"type":"text","text":"dev","marks":[{"type":"code"}]},{"type":"text","text":" can read the live "},{"type":"text","text":"configuration.php","marks":[{"type":"code"}]},{"type":"text","text":" with the DB password."}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Fix:","marks":[{"type":"bold"}]},{"type":"text","text":" chmod 640 configuration.php, owner www-data."}]}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" Medium"}]}
{"type":"heading","attrs":{"level":3,"source":"phase:h-exam-web:additional:f-exam-joomla-installation"},"content":[{"type":"text","text":"Joomla \`installation/\` directory left in webroot"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" post-install cleanup skipped (Joomla mandates deleting it). The install SQL under "},{"type":"text","text":"cms/installation/sql/","marks":[{"type":"code"}]},{"type":"text","text":" is world-readable and holds a "},{"type":"text","text":"planted LDAP bind cred","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"text","text":"admin/bobby7","marks":[{"type":"code"}]},{"type":"text","text":" ("},{"type":"text","text":"cred #7","marks":[{"type":"code"}]},{"type":"text","text":") in the "},{"type":"text","text":"plg_authentication_ldap","marks":[{"type":"code"}]},{"type":"text","text":" default params; stock ships these empty."}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Never skip post-install cleanup of defaults and placeholder files"}]}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" Low"}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-web:tested"},"content":[{"type":"text","text":"Also tested"}]}
{"type":"table","content":[{"type":"tableRow","content":[{"type":"tableHeaderCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Tested"}]}]},{"type":"tableHeaderCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Why it went nowhere"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"80/tcp Apache 2.4.41"}]}]},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"Only the Ubuntu default page; no application behind it."}]}]}]}],"attrs":{"source":"tested:h-exam-web"}}
doc ["type","content"] null
{"type":"heading","attrs":{"level":1,"source":"facts:h-exam-ms01"},"content":[{"type":"text","text":"ms01 (10.10.30.5)"}]}
{"type":"paragraph","attrs":{"source":"result:h-exam-ms01"},"content":[{"type":"text","text":"Result:","marks":[{"type":"bold"}]},{"type":"text","text":" low-privilege shell as "},{"type":"text","text":"defaultapppool","marks":[{"type":"code"}]},{"type":"text","text":", then SYSTEM. local.txt "},{"type":"text","text":"5f3c9a1e7d2b48c6a0e1f9d3b7c2a4e8","marks":[{"type":"code"}]},{"type":"text","text":", proof.txt "},{"type":"text","text":"c81e728d9d4c2f636f067f89cc14862c","marks":[{"type":"code"}]},{"type":"text","text":"."}]}
