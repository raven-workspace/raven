{"type":"paragraph","content":[{"type":"text","text":"Label:","marks":[{"type":"bold"}]},{"type":"text","text":" GetUserSPNs then hashcat -m 13100."}]}
]
{"type":"paragraph","content":[{"type":"text","text":"Label:","marks":[{"type":"bold"}]},{"type":"text","text":" A connection string on fs01 holds a working password."}]}
]
{"type":"paragraph","content":[{"type":"text","text":"Label:","marks":[{"type":"bold"}]},{"type":"text","text":" Move secrets to a vault."}]}
