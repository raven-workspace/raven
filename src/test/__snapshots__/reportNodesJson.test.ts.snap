{"type":"list","attrs":{"kind":"bullet","source":"tested:h-exam-ms01"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Password guessing for sa on 1433/tcp: precondition not met: No common password matched; the account needs a password from somewhere else."}]}]}
