{"type":"heading","attrs":{"level":1,"source":"facts:h-exam-web"},"content":[{"type":"text","text":"web01 (10.10.30.20)"}]}
{"type":"paragraph","content":[{"type":"text","text":"Result:","marks":[{"type":"bold"}]},{"type":"text","text":" shell as "},{"type":"text","text":"dev","marks":[{"type":"code"}]},{"type":"text","text":", then root. local.txt "},{"type":"text","text":"9b2e4f61c0d87a35e1f4b6c9d2a0e7f3","marks":[{"type":"code"}]},{"type":"text","text":", proof.txt "},{"type":"text","text":"e4da3b7fbbce2345d7772b0674a318d5","marks":[{"type":"code"}]},{"type":"text","text":"."}],"attrs":{"source":"result:h-exam-web"}}
