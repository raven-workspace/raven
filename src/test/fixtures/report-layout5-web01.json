    {
      "type": "finding",
      "attrs": {
        "findingId": "f-exam-grafana",
        "edited": false
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Vulnerability Explanation:",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " The plugin asset route of Grafana 8.0.0 to 8.3.0 does not normalise the path, so any file the grafana user can read is served without logging in. dev's private SSH key was readable."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Vulnerability Fix:",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            }
          ]
        },
        {
          "type": "list",
          "attrs": {
            "kind": "bullet"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Upgrade Grafana to 8.3.1 or later."
                }
              ]
            }
          ]
        },
        {
          "type": "list",
          "attrs": {
            "kind": "bullet"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Keep SSH private keys readable by their owner only."
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Severity:",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " High (CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N)"
            }
          ]
        }
      ]
    },
