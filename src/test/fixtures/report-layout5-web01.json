    {
      "type": "finding",
      "attrs": {
        "findingId": "f-exam-grafana-repo",
        "edited": false
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Vulnerability Explanation:",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " The web root serves "
            },
            {
              "type": "text",
              "text": "/.git/",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Its history holds the database password that a later commit removed:"
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": {
            "language": ""
          },
          "content": [
            {
              "type": "text",
              "text": "commit 4be1d9c07a52e3f86d10b2c4e7f9a0315d6c8e22 Author: Site Admin <admin@exam.lab> Date:   Fri Nov 18 17:22:48 2022 +0200\n\n    Add the reporting datasource\n\ndiff --git a/datasources/mysql.yaml b/datasources/mysql.yaml\n--- a/datasources/mysql.yaml\n+++ b/datasources/mysql.yaml\n@@ -4,7 +4,7 @@ class Database{\n-    private $username = \"dev@exam.lab\";\n-    private $password = \"CopperKite71\";\n+    private $username = \"\";\n+    private $password = \"\";\n     public function getConnection() {\n         $this->conn = null;\n         try{\n             $this->conn = new PDO(\"mysql:host=\" . $this->host . \";dbname=\" . $this->db_name, $this->username, $this->password);\n             $this->conn->exec(\"set names utf8\");\n         }catch(PDOException $exception){\n             echo \"Connection error: \" . $exception->getMessage();\n         }\n         return $this->conn;\n     }\n+} +?>"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Affected: grafana (port 3000)"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Vulnerability Fix:",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " env vars, .gitignore, secrets managers, pre-commit hooks like gitleaks. Once a secret has been pushed to remote, it's burned and must be rotated. Scrub repo history."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Severity:",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " High"
            }
          ]
        }
      ]
    },
