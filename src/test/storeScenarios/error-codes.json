{
  "name": "Missing records are not_found and bad input is a validation error on the field",
  "steps": [
    { "do": "engagementCreate", "args": [{ "name": "Errors lab", "kind": "lab" }], "as": "eng" },
    { "do": "hostCreate", "args": ["$eng", { "name": "ws01", "ip": "192.0.2.70" }], "as": "h" },

    { "do": "engagementGet", "args": ["no-such-engagement"], "error": { "code": "not_found" } },
    { "do": "engagementUpdate", "args": ["no-such-engagement", { "name": "x", "kind": "lab" }], "error": { "code": "not_found" } },
    { "do": "engagementSetStatus", "args": ["no-such-engagement", "archived"], "error": { "code": "not_found" } },
    { "do": "engagementDelete", "args": ["no-such-engagement"], "error": { "code": "not_found" } },
    { "do": "hostCreate", "args": ["no-such-engagement", { "name": "x" }], "error": { "code": "not_found" } },
    { "do": "hostUpdate", "args": ["no-such-host", { "name": "x" }], "error": { "code": "not_found" } },
    { "do": "hostMove", "args": ["no-such-host", "reporting"], "error": { "code": "not_found" } },
    { "do": "hostDelete", "args": ["no-such-host"], "error": { "code": "not_found" } },
    { "do": "serviceCreate", "args": ["no-such-host", { "port": 80 }], "error": { "code": "not_found" } },
    { "do": "serviceDelete", "args": ["no-such-service"], "error": { "code": "not_found" } },
    { "do": "logDelete", "args": ["no-such-entry"], "error": { "code": "not_found" } },
    { "do": "credentialDelete", "args": ["no-such-credential"], "error": { "code": "not_found" } },
    { "do": "usernameDelete", "args": ["no-such-username"], "error": { "code": "not_found" } },
    { "do": "findingDelete", "args": ["no-such-finding"], "error": { "code": "not_found" } },
    { "do": "ruledOutDelete", "args": ["no-such-item"], "error": { "code": "not_found" } },
    { "do": "tunnelDelete", "args": ["no-such-tunnel"], "error": { "code": "not_found" } },
    { "do": "hopDelete", "args": ["no-such-hop"], "error": { "code": "not_found" } },
    { "do": "accessGrantDelete", "args": ["no-such-grant"], "error": { "code": "not_found" } },
    { "do": "credAttemptDelete", "args": ["no-such-attempt"], "error": { "code": "not_found" } },
    { "do": "triedPairDelete", "args": ["no-such-pair"], "error": { "code": "not_found" } },
    { "do": "failedAttemptDelete", "args": ["no-such-attempt"], "error": { "code": "not_found" } },
    { "do": "findingFileDelete", "args": ["no-such-file"], "error": { "code": "not_found" } },
    { "do": "vectorDelete", "args": ["no-such-vector"], "error": { "code": "not_found" } },
    { "do": "cleanupDelete", "args": ["no-such-item"], "error": { "code": "not_found" } },
    { "do": "attachmentGet", "args": ["no-such-attachment"], "error": { "code": "not_found" } },

    { "do": "engagementCreate", "args": [{ "name": "  ", "kind": "lab" }], "error": { "code": "validation", "field": "name" } },
    { "do": "engagementCreate", "args": [{ "name": "x", "kind": "pentest" }], "error": { "code": "validation", "field": "kind" } },
    { "do": "engagementCreate", "args": [{ "name": "x", "kind": "lab", "scopeCidrs": ["192.0.2.0/33"] }], "error": { "code": "validation", "field": "scopeCidrs" } },
    { "do": "engagementCreate", "args": [{ "name": "x", "kind": "lab", "startsAt": 2000, "endsAt": 1000 }], "error": { "code": "validation", "field": "endsAt" } },
    { "do": "engagementSetStatus", "args": ["$eng", "paused"], "error": { "code": "validation", "field": "status" } },
    { "do": "hostCreate", "args": ["$eng", { "name": "x", "os": "bsd" }], "error": { "code": "validation", "field": "os" } },
    { "do": "hostCreate", "args": ["$eng", { "name": "x", "access": "admin" }], "error": { "code": "validation", "field": "access" } },
    { "do": "hostMove", "args": ["$h", "nowhere"], "error": { "code": "validation", "field": "column" } },
    { "do": "engagementsList", "args": [], "expect": [{ "id": "$eng", "name": "Errors lab" }] },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$h", "boardColumn": "information-gathering" }] }
  ]
}
