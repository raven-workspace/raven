{
  "name": "A local account on one host with the name and secret of a local credential stored for another host is password reuse: an attempt of that credential, no new username or credential; another secret, or none, files a local username",
  "steps": [
    { "do": "engagementCreate", "args": [{ "name": "Synthetic lab", "kind": "lab", "domain": "corp.example" }], "as": "eng" },
    { "do": "hostCreate", "args": ["$eng", { "name": "WEB01", "ip": "192.0.2.10" }], "as": "web" },
    { "do": "hostCreate", "args": ["$eng", { "name": "SQL01", "ip": "192.0.2.11" }], "as": "sql" },
    {
      "do": "credentialCreate",
      "args": ["$eng", { "type": "password", "username": "zoe", "secret": "Winter2024!", "scope": "local", "localHostId": "$web", "sourceHostId": "$web" }],
      "bind": { "webJen": "credential.id" }
    },
    {
      "do": "logCreate",
      "args": ["$eng", {
        "title": "local spray", "ranOn": null, "hostIds": ["$sql"], "observations": null,
        "returnedNothing": false, "private": false, "content": { "kind": "note", "text": "SQL01\\zoe:Winter2024!" }
      }],
      "as": "spray"
    },
    {
      "do": "extractionFile",
      "args": ["$eng", "$spray", {
        "createdHostIds": [], "newHosts": [], "scans": [], "identity": null, "credentials": [], "cracks": [], "usernames": [],
        "intake": {
          "usernames": [{ "key": "eng|zoe|.|local:sql", "input": { "username": "zoe", "domain": ".", "sourceHostId": "$sql", "source": "nxc" } }],
          "attempts": [{ "credId": "$webJen", "hostId": "$sql", "service": "smb", "port": 445, "result": "valid", "authMode": "local" }],
          "credentials": [], "hashes": [], "links": [], "reprovedCredentialIds": ["$webJen"], "reprovedUsernameIds": []
        },
        "triedPairs": [], "vectors": []
      }]
    },
    { "do": "usernamesList", "args": ["$eng"], "expect": [] },
    { "do": "credentialsList", "args": ["$eng"], "expect": [{ "id": "$webJen", "localHostId": "$web" }] },
    { "do": "credAttemptsList", "args": ["$eng"], "expect": [{ "credId": "$webJen", "hostId": "$sql", "service": "smb", "result": "valid", "authMode": "local" }] },

    {
      "do": "logCreate",
      "args": ["$eng", {
        "title": "sam dump", "ranOn": null, "hostIds": ["$sql"], "observations": null,
        "returnedNothing": false, "private": false, "content": { "kind": "note", "text": "zoe:Winter2024!" }
      }],
      "as": "dump"
    },
    {
      "do": "extractionFile",
      "args": ["$eng", "$dump", {
        "createdHostIds": [], "newHosts": [], "scans": [], "identity": null, "cracks": [], "usernames": [], "intake": null,
        "credentials": [{ "type": "password", "username": "ZOE", "secret": "Winter2024!", "scope": "local", "localHostId": "$sql", "sourceHostId": "$sql" }],
        "triedPairs": [], "vectors": []
      }]
    },
    { "do": "credentialsList", "args": ["$eng"], "expect": [{ "id": "$webJen" }] },
    {
      "do": "credAttemptsList", "args": ["$eng"],
      "expect": [
        { "credId": "$webJen", "hostId": "$sql", "service": "smb", "result": "valid" },
        { "credId": "$webJen", "hostId": "$sql", "service": "other", "result": "valid", "authMode": "local", "detail": "password reuse", "logEntryId": "$dump" }
      ]
    },
    { "do": "extractionUndo", "args": ["$dump"] },
    { "do": "credAttemptsList", "args": ["$eng"], "expect": [{ "credId": "$webJen", "service": "smb" }] },

    {
      "do": "logCreate",
      "args": ["$eng", {
        "title": "another password", "ranOn": null, "hostIds": ["$sql"], "observations": null,
        "returnedNothing": false, "private": false, "content": { "kind": "note", "text": "SQL01\\zoe:Spring2025!" }
      }],
      "as": "other"
    },
    {
      "do": "extractionFile",
      "args": ["$eng", "$other", {
        "createdHostIds": [], "newHosts": [], "scans": [], "identity": null, "credentials": [], "cracks": [], "usernames": [],
        "intake": {
          "usernames": [{ "key": "eng|zoe|.|local:sql", "input": { "username": "zoe", "domain": ".", "sourceHostId": "$sql", "source": "nxc" } }],
          "attempts": [],
          "credentials": [{
            "input": { "type": "password", "username": "zoe", "secret": "Spring2025!", "scope": "local", "localHostId": "$sql", "sourceHostId": "$sql" },
            "accepted": true,
            "attempts": [{ "hostId": "$sql", "service": "smb", "port": 445, "result": "valid", "authMode": "local" }],
            "fromUsername": null, "ifDeclined": []
          }],
          "hashes": [], "links": [], "reprovedCredentialIds": [], "reprovedUsernameIds": []
        },
        "triedPairs": [], "vectors": []
      }]
    },
    { "do": "usernamesList", "args": ["$eng"], "expect": [{ "username": "zoe", "scope": "local", "localHostId": "$sql" }] },
    {
      "do": "credentialsList", "args": ["$eng"],
      "expect": [{ "id": "$webJen", "localHostId": "$web" }, { "secret": "Spring2025!", "scope": "local", "localHostId": "$sql" }]
    },
    { "do": "extractionUndo", "args": ["$other"] },
    { "do": "usernamesList", "args": ["$eng"], "expect": [] },

    {
      "do": "logCreate",
      "args": ["$eng", {
        "title": "rid brute", "ranOn": null, "hostIds": ["$sql"], "observations": null,
        "returnedNothing": false, "private": false, "content": { "kind": "note", "text": "1001: SQL01\\zoe (SidTypeUser)" }
      }],
      "as": "listing"
    },
    {
      "do": "extractionFile",
      "args": ["$eng", "$listing", {
        "createdHostIds": [], "newHosts": [], "scans": [], "identity": null, "credentials": [], "cracks": [], "intake": null,
        "usernames": [{ "username": "zoe", "domain": "SQL01", "sourceHostId": "$sql", "source": "lookupsid" }],
        "triedPairs": [], "vectors": []
      }]
    },
    { "do": "usernamesList", "args": ["$eng"], "expect": [{ "username": "zoe", "domain": null, "scope": "local", "localHostId": "$sql" }] },
    { "do": "credentialsList", "args": ["$eng"], "expect": [{ "id": "$webJen" }] }
  ]
}
