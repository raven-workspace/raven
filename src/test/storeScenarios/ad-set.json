{
  "name": "A host is in the AD set by its switch, else by open services on both 88 and 389",
  "steps": [
    { "do": "engagementCreate", "args": [{ "name": "AD lab", "kind": "exam-sim", "domain": "corp.example" }], "as": "eng" },
    { "do": "hostCreate", "args": ["$eng", { "name": "dc09", "ip": "192.0.2.40" }], "as": "dc", "expect": { "adSet": null, "adSetEffective": false } },
    { "do": "serviceCreate", "args": ["$dc", { "port": 88 }], "as": "kerberos" },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": false }] },
    { "do": "serviceCreate", "args": ["$dc", { "port": 389 }], "as": "ldap" },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": true }] },
    { "do": "serviceUpdate", "args": ["$ldap", { "port": 636 }] },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": false }] },
    { "do": "serviceUpdate", "args": ["$ldap", { "port": 389 }] },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": true }] },
    { "do": "hostUpdate", "args": ["$dc", { "name": "dc09", "adSet": false }], "expect": { "adSet": false, "adSetEffective": false } },
    { "do": "hostUpdate", "args": ["$dc", { "name": "dc09" }], "expect": { "adSet": false, "adSetEffective": false } },
    { "do": "hostUpdate", "args": ["$dc", { "name": "dc09", "adSet": null }], "expect": { "adSet": null, "adSetEffective": true } },
    {
      "do": "servicesUpsertScan",
      "args": ["$dc", [{ "port": 88, "protocol": "tcp", "state": "open|filtered", "service": "kerberos-sec", "version": "" }]]
    },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": false }] },
    {
      "do": "servicesUpsertScan",
      "args": ["$dc", [{ "port": 88, "protocol": "tcp", "state": "open", "service": "kerberos-sec", "version": "" }]]
    },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": true }] },
    { "do": "serviceDelete", "args": ["$kerberos"] },
    { "do": "hostsList", "args": ["$eng"], "expect": [{ "id": "$dc", "adSetEffective": false }] },
    { "do": "hostUpdate", "args": ["$dc", { "name": "dc09", "adSet": true }], "expect": { "adSetEffective": true } },
    { "do": "hostCreate", "args": ["$eng", { "name": "ms09", "adSet": true }], "expect": { "adSet": true, "adSetEffective": true } }
  ]
}
