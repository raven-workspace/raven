{
  "name": "Deleting a host keeps its local usernames, still local and with no host; two left that way never collide",
  "steps": [
    { "do": "engagementCreate", "args": [{ "name": "Synthetic lab", "kind": "lab", "domain": "corp.example" }], "as": "eng" },
    { "do": "hostCreate", "args": ["$eng", { "name": "WEB01", "ip": "192.0.2.10" }], "as": "web" },
    { "do": "hostCreate", "args": ["$eng", { "name": "SQL01", "ip": "192.0.2.11" }], "as": "sql" },
    { "do": "hostCreate", "args": ["$eng", { "name": "FILES01", "ip": "192.0.2.12" }], "as": "files" },
    { "do": "usernameCreate", "args": ["$eng", { "username": "jay", "scope": "local", "localHostId": "$web", "sourceHostId": "$web" }], "as": "webJen" },
    { "do": "usernameCreate", "args": ["$eng", { "username": "jay", "scope": "local", "localHostId": "$sql" }], "as": "sqlJen" },
    { "do": "usernameCreate", "args": ["$eng", { "username": "jay", "domain": "CORP", "scope": "domain" }], "as": "domJen" },
    { "do": "accessGrantCreate", "args": ["$eng", { "usernameId": "$webJen", "hostId": "$files", "level": "user", "via": "winrm" }] },

    { "do": "hostDelete", "args": ["$web"] },
    { "do": "hostDelete", "args": ["$sql"] },

    {
      "do": "usernamesList", "args": ["$eng"],
      "expect": [
        { "id": "$webJen", "scope": "local", "localHostId": null, "sourceHostId": null },
        { "id": "$sqlJen", "scope": "local", "localHostId": null },
        { "id": "$domJen", "scope": "domain", "localHostId": null }
      ]
    },
    { "do": "accessGrantsList", "args": ["$eng"], "expect": [{ "usernameId": "$webJen", "hostId": "$files" }] },
    { "do": "usernameCreate", "args": ["$eng", { "username": "jay", "scope": "local" }], "error": { "code": "validation", "field": "localHostId" } },
    { "do": "usernameCreate", "args": ["$eng", { "username": "jay", "scope": "local", "localHostId": "$files" }], "as": "filesJen" },
    { "do": "usernamesList", "args": ["$eng"], "expect": [{ "id": "$webJen" }, { "id": "$sqlJen" }, { "id": "$domJen" }, { "id": "$filesJen", "localHostId": "$files" }] }
  ]
}
