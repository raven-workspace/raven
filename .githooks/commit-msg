#!/bin/sh

# --- slop-stop commit-msg hook ---
# Blocks AI co-author trailers / attribution lines in commit messages.
# Installed by: slop-stop hook install
# Remove with:  slop-stop hook uninstall
# Drop comment lines and anything below the `git commit -v` scissors line.
slop_msg=$(sed '/^# -* >8 -*$/,$d' "$1" | grep -v '^#')
slop_blocked=0
slop_check() {
    slop_hit=$(printf '%s\n' "$slop_msg" | grep -Ei -m1 -e "$1") || return 0
    slop_blocked=$((slop_blocked + 1))
    echo "  BLOCKED: $slop_hit ($2)"
}
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Claude.*<noreply@anthropic\.com>' 'Claude Code'
slop_check '^[[:space:]]*(🤖[[:space:]]*)?Generated with.*Claude Code' 'Claude Code'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Claude.*<claude@anthropic\.com>' 'Claude Code'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Cursor.*<cursoragent@cursor\.com>' 'Cursor'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*cursor\[bot\]' 'Cursor'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*aider.*<noreply@aider\.chat>' 'Aider'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*aider.*<aider@aider\.chat>' 'Aider'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*copilot-swe-agent\[bot\]' 'GitHub Copilot'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Copilot.*<noreply@github\.com>' 'GitHub Copilot'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Devin AI.*devin-ai-integration' 'Devin'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*devin-ai-integration\[bot\]' 'Devin'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*codex-connector\[bot\]' 'OpenAI Codex'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*openai-codex' 'OpenAI Codex'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Cline.*<cline@' 'Cline'
slop_check '^[[:space:]]*Co-authored-by:[[:space:]]*.*Amazon Q' 'Amazon Q'
slop_check '^[[:space:]]*Generated by AI' 'Generic AI'
if [ "$slop_blocked" -gt 0 ]; then
    echo ""
    echo "slop-stop: AI attribution found in commit message."
    echo "Remove the line(s) above or use 'git commit --no-verify' to bypass."
    exit 1
fi
# --- end slop-stop ---
